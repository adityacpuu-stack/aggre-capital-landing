# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Authentication & Security
JWT_SECRET=
SESSION_SECRET=
SESSION_EXPIRY_HOURS=24

# Email Configuration (Resend, server-side only)
RESEND_API_KEY=
# Use an address on a domain verified in your Resend account.
RESEND_FROM_EMAIL="AGGRE CAPITAL <notifikasi@your-domain.com>"
RESEND_REPLY_TO=
ADMIN_EMAIL=admin@domain.com
EMAIL_DISABLED=false

# Application URLs (Update with your domain)
NEXT_PUBLIC_DASHBOARD_URL=https://your-domain.com/dashboard
FRONTEND_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com
NODE_ENV=production

# Development optimizations
NEXT_TELEMETRY_DISABLED=1

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,pdf,doc,docx,txt

# Rate Limiting Configuration
# Rate limiting is enforced by the Vercel Firewall rule documented in docs/FORM_PROTECTION.md.
# Cloudflare Turnstile (production keys required before deployment)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=aggrecapital.com,www.aggrecapital.com

# CORS Configuration
CORS_CREDENTIALS=true

# Analytics Configuration
NEXT_PUBLIC_ANALYTICS_ENABLED=false
